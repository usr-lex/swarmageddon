+// storeRepoCredentials writes repository credentials, waiting up to wait for
+// the operator to create the workspace's repo-credentials Secret.
+func storeRepoCredentials(ctx context.Context, k *k8s.Client, ws string, creds map[string][]byte, wait time.Duration) error {
+	deadline := time.Now().Add(wait)
+	for {
+		err := k.SetRepoCredentials(ctx, ws, creds)
+		if !errors.Is(err, k8s.ErrRepoCredentialsMissing) || time.Now().After(deadline) {
+			return err
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(time.Second):
+		}
+	}
+}
