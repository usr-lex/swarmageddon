@@ -0,0 +1,48 @@
+package wizard
+
+import (
+	"testing"
+
+	ccv1 "github.com/usr-lex/swarmageddon/gen/swarm/controlcenter/v1"
+	"github.com/usr-lex/swarmageddon/internal/controlcenter/k8s"
+)
+
+func TestRepoCredentials(t *testing.T) {
+	p := &ccv1.WorkspacePlan{Name: "acme", Org: "acme", Repositories: []*ccv1.RepositoryPlan{
+		{Name: "api", ImportUrl: "https://github.com/acme/api.git", ImportCredential: "bot:ghp_import",
+			PushMirror: "https://github.com/acme/api-mirror.git", MirrorToken: "ghp_mirror"},
+		{Name: "web"},
+		{Name: "docs", ImportUrl: "https://example.com/docs.git", ImportSecretName: "legacy"},
+	}}
+	got := RepoCredentials(p)
+	want := map[string]string{"api.import.token": "ghp_import", "api.import.username": "bot", "api.mirror.token": "ghp_mirror"}
+	for k, v := range want {
+		if string(got[k]) != v {
+			t.Errorf("%s = %q, want %q", k, got[k], v)
+		}
+	}
+	if v, ok := got["api.mirror.username"]; !ok || v != nil {
+		t.Errorf("a bare token should clear the username: %v %v", v, ok)
+	}
+	if len(got) != 4 {
+		t.Errorf("keys %v", got)
+	}
+
+	d := Build(p, Current{})
+	repos := d.Workspace.Spec.Repositories
+	if repos[0].ImportSecretName != k8s.RepoCredentialsName || repos[0].MirrorSecretName != k8s.RepoCredentialsName {
+		t.Fatalf("api secrets %+v", repos[0])
+	}
+	if repos[1].ImportSecretName != "" || repos[1].MirrorSecretName != "" || repos[2].ImportSecretName != "legacy" {
+		t.Fatalf("other repos %+v", repos[1:])
+	}
+	// The spec never holds the credential, and reading the plan back keeps
+	// the Secret's name but not the value.
+	back := FromCluster(Current{Workspace: d.Workspace})
+	if r := back.Repositories[0]; r.ImportCredential != "" || r.MirrorToken != "" || r.ImportSecretName != k8s.RepoCredentialsName {
+		t.Fatalf("round trip %+v", r)
+	}
+	if RepoCredentials(&ccv1.WorkspacePlan{Repositories: []*ccv1.RepositoryPlan{{Name: "x"}}}) != nil {
+		t.Fatal("no credentials should give nil")
+	}
+}
