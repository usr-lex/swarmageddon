+package k8s
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/types"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+
+	"github.com/usr-lex/swarmageddon/api/v1alpha1"
+)
+
+func TestAllowedSecret(t *testing.T) {
+	for _, n := range []string{SecretNtfyPublisher, SecretVAPID, "notify-acme-slack", "forge-webhook-acme"} {
+		if !AllowedSecret(n) {
+			t.Errorf("%s not allowed", n)
+		}
+	}
+	for _, n := range []string{"platform-ca", "forgejo-admin", "notify-", "ntfy-auth"} {
+		if AllowedSecret(n) {
+			t.Errorf("%s allowed", n)
+		}
+	}
+}
+
+func TestRepoCredentials(t *testing.T) {
+	ctx := context.Background()
+	ns := v1alpha1.WorkspaceNamespace("acme")
+	c := fake.NewClientBuilder().WithScheme(Scheme()).Build()
+	kc := &Client{C: c, Namespace: v1alpha1.SystemNamespace}
+
+	key := RepoCredentialKey("api", "mirror", "token")
+	if key != "api.mirror.token" {
+		t.Fatalf("key %q", key)
+	}
+	if err := kc.SetRepoCredentials(ctx, "acme", map[string][]byte{key: []byte("ghp_x")}); !errors.Is(err, ErrRepoCredentialsMissing) {
+		t.Fatalf("missing secret: %v", err)
+	}
+	// The operator creates it empty; the control center only fills it.
+	if err := c.Create(ctx, &corev1.Secret{ObjectMeta: metav1.ObjectMeta{Name: RepoCredentialsName, Namespace: ns}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := kc.SetRepoCredentials(ctx, "acme", map[string][]byte{key: []byte("ghp_x"), "api.import.token": []byte("t1")}); err != nil {
+		t.Fatal(err)
+	}
+	if err := kc.SetRepoCredentials(ctx, "acme", map[string][]byte{"api.import.token": nil, "api.import.username": nil}); err != nil {
+		t.Fatal(err)
+	}
+	var s corev1.Secret
+	if err := c.Get(ctx, types.NamespacedName{Namespace: ns, Name: RepoCredentialsName}, &s); err != nil {
+		t.Fatal(err)
+	}
+	if len(s.Data) != 1 || string(s.Data[key]) != "ghp_x" {
+		t.Fatalf("data %v", s.Data)
+	}
+	// room-secrets is a separate Secret.
+	if err := kc.SetRoomSecretKey(ctx, "acme", "X", []byte("y")); !errors.Is(err, ErrRoomSecretsMissing) {
+		t.Fatalf("room-secrets: %v", err)
+	}
+}
