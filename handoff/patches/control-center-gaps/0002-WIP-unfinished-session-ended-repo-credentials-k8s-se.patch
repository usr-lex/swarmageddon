+// RepoCredentials returns the repo-credentials keys a plan's write-only
+// repository credentials set (k8s.RepoCredentialKey), or nil. A credential is
+// "token" or "username:token"; the operator defaults the username to oauth2.
+func RepoCredentials(p *ccv1.WorkspacePlan) map[string][]byte {
+	var out map[string][]byte
+	add := func(repo, kind, cred string) {
+		if cred == "" {
+			return
+		}
+		if out == nil {
+			out = map[string][]byte{}
+		}
+		user, token, ok := strings.Cut(cred, ":")
+		if !ok {
+			user, token = "", cred
+		}
+		out[k8s.RepoCredentialKey(repo, kind, "token")] = []byte(token)
+		if user != "" {
+			out[k8s.RepoCredentialKey(repo, kind, "username")] = []byte(user)
+		} else {
+			out[k8s.RepoCredentialKey(repo, kind, "username")] = nil // drop a stale username
+		}
+	}
+	for _, r := range p.GetRepositories() {
+		add(r.GetName(), "import", r.GetImportCredential())
+		add(r.GetName(), "mirror", r.GetMirrorToken())
+	}
+	return out
+}
+
